# Base URL of the WatchStash backend API, without a trailing slash.
# This value is inlined into the browser bundle at BUILD time:
# set it in your hosting provider's environment BEFORE deploying.
#
# Local development (backend via `bun run dev:backend`):
NEXT_PUBLIC_API_URL=http://localhost:3001
#
# Production example:
# NEXT_PUBLIC_API_URL=https://watch-stash-backend.vercel.app
