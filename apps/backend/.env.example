# Generate secrets with: openssl rand -base64 32
PORT=3001
MONGODB_URI=mongodb://localhost:27017/watchstash
JWT_SECRET=your_generated_secret_here
JWT_REFRESH_SECRET=your_generated_refresh_secret_here
CORS_ORIGIN=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000

# OAuth provider credentials are optional.
# OAUTH_STATE_SECRET is required for OAuth state signing.
OAUTH_STATE_SECRET=your_generated_state_secret_here

# Create OAuth apps and set redirect URI to:
# http://localhost:3001/api/auth/oauth/<provider>/callback

# Google: https://console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client (Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub: https://github.com/settings/developers -> New OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Facebook: https://developers.facebook.com -> app -> Facebook Login (development mode)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# X (Twitter): https://developer.x.com -> OAuth 2.0 (enable PKCE + users.read + tweet.read)
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
