# Generate secrets with: openssl rand -base64 32
PORT=3001
MONGODB_URI=mongodb://localhost:27017/watchstash
JWT_SECRET=your_generated_secret_here
JWT_REFRESH_SECRET=your_generated_refresh_secret_here
CORS_ORIGIN=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000

# Vercel deployment:
# - PORT is not needed (defaults to 3001; the platform manages ports).
# - MONGODB_URI should point to your hosted MongoDB (e.g. MongoDB Atlas SRV string).
# - CORS_ORIGIN and FRONTEND_ORIGIN must be set to the deployed frontend origin,
#   e.g. https://your-frontend.vercel.app (no trailing slash).
# - Configure each OAuth provider callback URL as:
#   https://<your-backend-domain>/api/auth/oauth/<provider>/callback

# OAuth provider credentials are optional.
# OAUTH_STATE_SECRET is required for OAuth state signing.
OAUTH_STATE_SECRET=your_generated_state_secret_here

# Create OAuth apps and set redirect URI to:
# http://localhost:3001/api/auth/oauth/<provider>/callback

# Google: https://console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client (Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub: https://github.com/settings/developers -> New OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Facebook: https://developers.facebook.com -> app -> Facebook Login (development mode)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# X (Twitter): https://developer.x.com -> OAuth 2.0 (enable PKCE + users.read + tweet.read)
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# TMDB: https://www.themoviedb.org/settings/api -> "API Read Access Token (v4)"
# Used by the media provider proxy /api/media + /api/stash/from-provider.
# Either TMDB_ACCESS_TOKEN (v4, Bearer) or TMDB_API_KEY (v3, api_key param) is required.
# Leave blank to keep the app running; media endpoints will return a clear config error.
TMDB_ACCESS_TOKEN=
TMDB_API_KEY=

# Upstash Redis (https://console.upstash.com) - cache + rate limiting on Vercel serverless.
# - "REST API" section -> UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN.
# - Without these, the app falls back to an in-memory cache and disables rate limiting (dev only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
